{
  "name": "arriendai",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --webpack --hostname localhost",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname localhost",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:check": "node scripts/check-db.mjs",
    "db:seed-demo": "node scripts/seed-demo.mjs",
    "test": "node --import tsx --test tests/ledger.test.mjs tests/charge-plan.test.mjs",
    "test:db": "node --conditions=react-server --import tsx --test tests/operations.test.ts"
  },
  "license": "ISC",
  "description": "",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.21",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
